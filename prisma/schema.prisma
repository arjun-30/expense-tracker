// Manufacturing Expense & Cost Management System — data model
// Prisma 7 SQL setup: no `url` here — see prisma.config.ts for the datasource URL.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Identity / RBAC ─────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  ACCOUNTS
  PURCHASE_MANAGER
  MAINTENANCE_MANAGER
  TRANSPORT_MANAGER
  EMPLOYEE
}

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  passwordHash        String
  role                Role
  departmentId        String?
  department          Department? @relation(fields: [departmentId], references: [id])
  phone               String?
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  passwordResetToken  String?   @unique
  passwordResetExpiry DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  expensesSubmitted   Expense[]            @relation("ExpenseEmployee")
  expensesApproved    Expense[]            @relation("ExpenseApprover")
  expenseAttachments  ExpenseAttachment[]
  expenseApprovals    ExpenseApproval[]
  purchaseOrders      PurchaseOrder[]
  payments            Payment[]
  maintenanceRecords  MaintenanceRecord[]
  spareIssued         MaintenanceSpare[]   @relation("SpareIssuedBy")
  spareReceived       MaintenanceSpare[]   @relation("SpareReceivedBy")
  inventoryPerformed  InventoryTransaction[] @relation("InventoryPerformedBy")
  inventoryReceived   InventoryTransaction[] @relation("InventoryReceivedBy")
  budgetsCreated      Budget[]
  notifications       Notification[]
  auditLogs           AuditLog[]

  @@index([role])
  @@index([departmentId])
}

model Department {
  id        String       @id @default(cuid())
  name      String       @unique
  code      String       @unique
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())

  users       User[]
  costCenters CostCenter[]
  expenses    Expense[]
  vehicles    Vehicle[]
  machines    Machine[]
  budgets     Budget[]
}

model CostCenter {
  id           String      @id @default(cuid())
  name         String
  code         String      @unique
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())

  expenses Expense[]
  budgets  Budget[]
}

// ───────────────────────── Expenses ─────────────────────────

model ExpenseCategory {
  id       String            @id @default(cuid())
  name     String
  code     String            @unique
  parentId String?
  parent   ExpenseCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children ExpenseCategory[] @relation("CategoryTree")
  isActive Boolean           @default(true)

  expenses          Expense[] @relation("ExpenseCategory")
  expensesSub       Expense[] @relation("ExpenseSubcategory")
  budgets           Budget[]

  @@index([parentId])
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  NEFT
  RTGS
  CHEQUE
  CREDIT
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
}

model Expense {
  id              String        @id @default(cuid())
  expenseNumber   String        @unique
  date            DateTime
  categoryId      String
  category        ExpenseCategory @relation("ExpenseCategory", fields: [categoryId], references: [id])
  subcategoryId   String?
  subcategory     ExpenseCategory? @relation("ExpenseSubcategory", fields: [subcategoryId], references: [id])
  amount          Decimal       @db.Decimal(14, 2)
  taxAmount       Decimal       @default(0) @db.Decimal(14, 2)
  discountAmount  Decimal       @default(0) @db.Decimal(14, 2)
  totalAmount     Decimal       @db.Decimal(14, 2)
  vendorId        String?
  vendor          Vendor?       @relation(fields: [vendorId], references: [id])
  departmentId    String
  department      Department    @relation(fields: [departmentId], references: [id])
  costCenterId    String?
  costCenter      CostCenter?   @relation(fields: [costCenterId], references: [id])
  employeeId      String
  employee        User          @relation("ExpenseEmployee", fields: [employeeId], references: [id])
  paymentMethod   PaymentMethod?
  paymentStatus   PaymentStatus @default(PENDING)
  description     String?
  referenceNumber String?
  status          ExpenseStatus @default(DRAFT)
  approvedById    String?
  approvedBy      User?         @relation("ExpenseApprover", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  remarks         String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  attachments ExpenseAttachment[]
  approvals   ExpenseApproval[]

  @@index([status])
  @@index([date])
  @@index([departmentId])
  @@index([categoryId])
  @@index([employeeId])
  @@index([vendorId])
}

model ExpenseAttachment {
  id           String   @id @default(cuid())
  expenseId    String
  expense      Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String
  fileType     String
  fileSize     Int
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())

  @@index([expenseId])
}

enum ApprovalAction {
  SUBMITTED
  REVIEWED
  VERIFIED
  APPROVED
  REJECTED
  PAID
  CANCELLED
}

model ExpenseApproval {
  id         String         @id @default(cuid())
  expenseId  String
  expense    Expense        @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  action     ApprovalAction
  actedById  String
  actedBy    User           @relation(fields: [actedById], references: [id])
  actedAt    DateTime       @default(now())
  remarks    String?
  fromStatus ExpenseStatus
  toStatus   ExpenseStatus

  @@index([expenseId])
}

// ───────────────────────── Vendors / Purchasing ─────────────────────────

enum VendorStatus {
  ACTIVE
  INACTIVE
}

model Vendor {
  id             String       @id @default(cuid())
  name           String
  contactPerson  String?
  phone          String?
  email          String?
  address        String?
  gstNumber      String?
  pan            String?
  category       String?
  paymentTerms   String?
  bankDetails    Json?
  status         VendorStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())

  expenses       Expense[]
  purchaseOrders PurchaseOrder[]
  invoices       Invoice[]
  payments       Payment[]
  spareParts     SparePart[]
  transportTrips TransportTrip[]

  @@index([status])
}

enum PurchaseOrderStatus {
  REQUESTED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id                String              @id @default(cuid())
  poNumber          String              @unique
  vendorId          String
  vendor            Vendor              @relation(fields: [vendorId], references: [id])
  status            PurchaseOrderStatus @default(REQUESTED)
  expectedDelivery  DateTime?
  actualDelivery    DateTime?
  totalAmount       Decimal             @db.Decimal(14, 2)
  createdById       String
  createdBy         User                @relation(fields: [createdById], references: [id])
  createdAt         DateTime            @default(now())

  items     PurchaseOrderItem[]
  invoices  Invoice[]

  @@index([status])
  @@index([vendorId])
}

model PurchaseOrderItem {
  id                String        @id @default(cuid())
  purchaseOrderId   String
  purchaseOrder     PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  sparePartId       String?
  sparePart         SparePart?    @relation(fields: [sparePartId], references: [id])
  description       String
  quantity          Decimal       @db.Decimal(12, 2)
  unitPrice         Decimal       @db.Decimal(14, 2)
  gstPercent        Decimal       @default(0) @db.Decimal(5, 2)
  total             Decimal       @db.Decimal(14, 2)
  receivedQuantity  Decimal       @default(0) @db.Decimal(12, 2)

  @@index([purchaseOrderId])
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  DISPUTED
  CANCELLED
}

model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String
  vendorId        String
  vendor          Vendor        @relation(fields: [vendorId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  amount          Decimal       @db.Decimal(14, 2)
  taxAmount       Decimal       @default(0) @db.Decimal(14, 2)
  totalAmount     Decimal       @db.Decimal(14, 2)
  invoiceDate     DateTime
  dueDate         DateTime?
  status          InvoiceStatus @default(UNPAID)
  filePath        String?
  createdAt       DateTime      @default(now())

  payments Payment[]

  @@unique([vendorId, invoiceNumber])
  @@index([status])
}

model Payment {
  id              String        @id @default(cuid())
  paymentNumber   String        @unique
  vendorId        String
  vendor          Vendor        @relation(fields: [vendorId], references: [id])
  invoiceId       String?
  invoice         Invoice?      @relation(fields: [invoiceId], references: [id])
  amount          Decimal       @db.Decimal(14, 2)
  paymentDate     DateTime
  method          PaymentMethod
  referenceNumber String?
  bank            String?
  status          PaymentStatus @default(PENDING)
  remarks         String?
  createdById     String
  createdBy       User          @relation(fields: [createdById], references: [id])
  createdAt       DateTime      @default(now())

  @@index([status])
  @@index([vendorId])
}

// ───────────────────────── Vehicles / Fuel / Transportation ─────────────────────────

enum VehicleStatus {
  ACTIVE
  UNDER_MAINTENANCE
  INACTIVE
  SOLD
}

model Vehicle {
  id                  String        @id @default(cuid())
  registrationNumber  String        @unique
  vehicleType         String
  manufacturer        String?
  model               String?
  year                Int?
  driverId            String?
  driver              Driver?       @relation(fields: [driverId], references: [id])
  departmentId        String?
  department          Department?   @relation(fields: [departmentId], references: [id])
  purchaseDate        DateTime?
  insuranceExpiry     DateTime?
  pollutionExpiry     DateTime?
  fitnessExpiry       DateTime?
  currentOdometer     Decimal       @default(0) @db.Decimal(12, 2)
  status              VehicleStatus @default(ACTIVE)
  createdAt           DateTime      @default(now())

  fuelTransactions FuelTransaction[]
  trips            TransportTrip[]

  @@index([status])
}

model Driver {
  id             String    @id @default(cuid())
  name           String
  phone          String?
  licenseNumber  String?
  licenseExpiry  DateTime?
  isActive       Boolean   @default(true)

  vehicles         Vehicle[]
  fuelTransactions FuelTransaction[]
  trips            TransportTrip[]
}

enum FuelType {
  DIESEL
  PETROL
  CNG
  OTHER
}

model FuelTransaction {
  id                      String   @id @default(cuid())
  vehicleId               String
  vehicle                 Vehicle  @relation(fields: [vehicleId], references: [id])
  driverId                String?
  driver                  Driver?  @relation(fields: [driverId], references: [id])
  date                    DateTime
  fuelType                FuelType
  fuelStation             String?
  litres                  Decimal  @db.Decimal(10, 2)
  ratePerLitre            Decimal  @db.Decimal(10, 2)
  totalAmount             Decimal  @db.Decimal(14, 2)
  odometerReading         Decimal  @db.Decimal(12, 2)
  previousOdometerReading Decimal  @db.Decimal(12, 2)
  distanceTravelled       Decimal  @db.Decimal(12, 2)
  efficiencyKmpl          Decimal? @db.Decimal(10, 3)
  costPerKm               Decimal? @db.Decimal(10, 3)
  isAnomaly               Boolean  @default(false)
  anomalyNote             String?
  paymentMethod           PaymentMethod?
  billUrl                 String?
  remarks                 String?
  createdAt               DateTime @default(now())

  @@index([vehicleId])
  @@index([date])
}

model TransportTrip {
  id             String        @id @default(cuid())
  tripNumber     String        @unique
  date           DateTime
  vehicleId      String
  vehicle        Vehicle       @relation(fields: [vehicleId], references: [id])
  transporterId  String?
  transporter    Vendor?       @relation(fields: [transporterId], references: [id])
  driverId       String?
  driver         Driver?       @relation(fields: [driverId], references: [id])
  source         String
  destination    String
  material       String?
  quantity       Decimal?      @db.Decimal(12, 2)
  unit           String?
  numberOfTrips  Int           @default(1)
  freight        Decimal       @default(0) @db.Decimal(14, 2)
  loadingCost    Decimal       @default(0) @db.Decimal(14, 2)
  unloadingCost  Decimal       @default(0) @db.Decimal(14, 2)
  toll           Decimal       @default(0) @db.Decimal(14, 2)
  parking        Decimal       @default(0) @db.Decimal(14, 2)
  otherCharges   Decimal       @default(0) @db.Decimal(14, 2)
  totalCost      Decimal       @db.Decimal(14, 2)
  costPerKg      Decimal?      @db.Decimal(10, 3)
  invoiceUrl     String?
  paymentStatus  PaymentStatus @default(PENDING)
  createdAt      DateTime      @default(now())

  @@index([vehicleId])
  @@index([date])
}

// ───────────────────────── Machinery / Maintenance / Spares ─────────────────────────

enum MachineStatus {
  RUNNING
  IDLE
  UNDER_MAINTENANCE
  BREAKDOWN
  RETIRED
}

model Machine {
  id                     String        @id @default(cuid())
  machineCode            String        @unique
  name                   String
  category               String?
  manufacturer           String?
  model                  String?
  serialNumber           String?
  purchaseDate           DateTime?
  purchasePrice          Decimal?      @db.Decimal(14, 2)
  location               String?
  departmentId           String?
  department             Department?   @relation(fields: [departmentId], references: [id])
  warrantyExpiry         DateTime?
  expectedLifespanMonths Int?
  status                 MachineStatus @default(RUNNING)
  createdAt              DateTime      @default(now())

  maintenanceRecords MaintenanceRecord[]
  compatibleSpares   SparePartMachine[]

  @@index([status])
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
  BREAKDOWN
  EMERGENCY
  SCHEDULED_SERVICE
}

model MaintenanceRecord {
  id                  String          @id @default(cuid())
  ticketNumber        String          @unique
  machineId           String
  machine             Machine         @relation(fields: [machineId], references: [id])
  date                DateTime
  maintenanceType     MaintenanceType
  problem             String?
  diagnosis           String?
  technician          String?
  labourCost          Decimal         @default(0) @db.Decimal(14, 2)
  sparePartsCost      Decimal         @default(0) @db.Decimal(14, 2)
  otherCost           Decimal         @default(0) @db.Decimal(14, 2)
  totalCost           Decimal         @db.Decimal(14, 2)
  downtimeMinutes     Int?
  startTime           DateTime?
  endTime             DateTime?
  invoiceUrl          String?
  remarks             String?
  nextMaintenanceDate DateTime?
  status              String          @default("OPEN")
  createdById         String
  createdBy           User            @relation(fields: [createdById], references: [id])
  createdAt           DateTime        @default(now())

  spares MaintenanceSpare[]

  @@index([machineId])
  @@index([date])
}

model MaintenanceSpare {
  id                  String            @id @default(cuid())
  maintenanceRecordId String
  maintenanceRecord   MaintenanceRecord @relation(fields: [maintenanceRecordId], references: [id], onDelete: Cascade)
  sparePartId         String
  sparePart           SparePart         @relation(fields: [sparePartId], references: [id])
  quantity            Decimal           @db.Decimal(12, 2)
  unitCost            Decimal           @db.Decimal(14, 2)
  totalCost           Decimal           @db.Decimal(14, 2)
  issuedById          String
  issuedBy            User              @relation("SpareIssuedBy", fields: [issuedById], references: [id])
  receivedById        String?
  receivedBy          User?             @relation("SpareReceivedBy", fields: [receivedById], references: [id])
  issuedAt            DateTime          @default(now())

  @@index([sparePartId])
  @@index([maintenanceRecordId])
}

enum SparePartStatus {
  ACTIVE
  DISCONTINUED
}

model SparePart {
  id              String          @id @default(cuid())
  partNumber      String          @unique
  name            String
  category        String?
  description     String?
  supplierId      String?
  supplier        Vendor?         @relation(fields: [supplierId], references: [id])
  unit            String          @default("pcs")
  purchasePrice   Decimal         @default(0) @db.Decimal(14, 2)
  currentStock    Decimal         @default(0) @db.Decimal(12, 2)
  minimumStock    Decimal         @default(0) @db.Decimal(12, 2)
  maximumStock    Decimal?        @db.Decimal(12, 2)
  storageLocation String?
  status          SparePartStatus @default(ACTIVE)
  createdAt       DateTime        @default(now())

  compatibleMachines  SparePartMachine[]
  maintenanceSpares   MaintenanceSpare[]
  inventoryTxns       InventoryTransaction[]
  purchaseOrderItems  PurchaseOrderItem[]

  @@index([status])
}

model SparePartMachine {
  sparePartId String
  sparePart   SparePart @relation(fields: [sparePartId], references: [id], onDelete: Cascade)
  machineId   String
  machine     Machine   @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@id([sparePartId, machineId])
}

enum InventoryTxnType {
  PURCHASE
  ISSUE
  RETURN
  ADJUSTMENT
  REPLACEMENT
  DAMAGED
  SCRAP
}

model InventoryTransaction {
  id                  String            @id @default(cuid())
  sparePartId         String
  sparePart           SparePart         @relation(fields: [sparePartId], references: [id])
  type                InventoryTxnType
  quantity            Decimal           @db.Decimal(12, 2)
  machineId           String?
  purchaseOrderId     String?
  unitCost            Decimal?          @db.Decimal(14, 2)
  totalCost           Decimal?          @db.Decimal(14, 2)
  performedById       String
  performedBy         User              @relation("InventoryPerformedBy", fields: [performedById], references: [id])
  receivedById        String?
  receivedBy          User?             @relation("InventoryReceivedBy", fields: [receivedById], references: [id])
  notes               String?
  createdAt           DateTime          @default(now())

  @@index([sparePartId])
  @@index([type])
  @@index([createdAt])
}

// ───────────────────────── Budgets ─────────────────────────

enum BudgetPeriod {
  MONTHLY
  QUARTERLY
  YEARLY
}

model Budget {
  id           String       @id @default(cuid())
  name         String
  departmentId String?
  department   Department?  @relation(fields: [departmentId], references: [id])
  categoryId   String?
  category     ExpenseCategory? @relation(fields: [categoryId], references: [id])
  costCenterId String?
  costCenter   CostCenter?  @relation(fields: [costCenterId], references: [id])
  period       BudgetPeriod
  periodStart  DateTime
  periodEnd    DateTime
  amount       Decimal      @db.Decimal(14, 2)
  createdById  String
  createdBy    User         @relation(fields: [createdById], references: [id])
  createdAt    DateTime     @default(now())

  @@index([departmentId])
  @@index([categoryId])
  @@index([periodStart, periodEnd])
}

// ───────────────────────── Rules / Notifications / Audit ─────────────────────────

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

model AlertRule {
  id            String        @id @default(cuid())
  key           String        @unique
  name          String
  description   String?
  module        String?
  conditionJson Json
  severity      AlertSeverity
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Notification {
  id         String        @id @default(cuid())
  userId     String?
  user       User?         @relation(fields: [userId], references: [id])
  role       Role?
  type       String
  severity   AlertSeverity @default(INFO)
  title      String
  message    String
  entityType String?
  entityId   String?
  isRead     Boolean       @default(false)
  createdAt  DateTime      @default(now())

  @@index([userId, isRead])
  @@index([role, isRead])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  module    String
  recordId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([module])
  @@index([recordId])
  @@index([createdAt])
}

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

// ───────────────────────── Deferred (schema-ready, no UI this phase) ─────────────────────────

model ProductionOrder {
  id          String    @id @default(cuid())
  orderNumber String    @unique
  product     String
  quantity    Decimal   @db.Decimal(12, 2)
  unit        String
  status      String    @default("PLANNED")
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())

  productionExpenses ProductionExpense[]
  printingExpenses   PrintingExpense[]
}

model ProductionExpense {
  id                String          @id @default(cuid())
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id])
  type              String
  amount            Decimal         @db.Decimal(14, 2)
  date              DateTime        @default(now())
}

model PrintingExpense {
  id                String           @id @default(cuid())
  productionOrderId String?
  productionOrder   ProductionOrder? @relation(fields: [productionOrderId], references: [id])
  category          String
  amount            Decimal          @db.Decimal(14, 2)
  date              DateTime         @default(now())
}
