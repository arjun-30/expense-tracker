// Manufacturing Expense & Cost Management System — data model
// ERP full-schema expansion (44 tables): Foundation / Finance / Operations /
// Procurement / Management. See prisma/SCHEMA_MIGRATION_NOTES.md for the full
// rationale behind every rename/replace/drop decision, and
// prisma/OPEN_DECISIONS.md for the human decisions this schema implements.
//
// Prisma 7 SQL setup: no `url` here — see prisma.config.ts for the datasource URL.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Foundation: company / RBAC ─────────────────────────

model Company {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(200)
  legalName String?  @map("legal_name") @db.VarChar(200)
  gstNumber String?  @unique @map("gst_number") @db.VarChar(20)
  pan       String?  @db.VarChar(15)
  address   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  roles             Role[]
  departments       Department[]
  costCenters       CostCenter[]
  users             User[]
  expenseCategories ExpenseCategory[]
  vendors           Vendor[]
  expenses          Expense[]
  payments          Payment[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  vehicles          Vehicle[]
  drivers           Driver[]
  transporters      Transporter[]
  transportTrips    TransportTrip[]
  machines          Machine[]
  consumables       Consumable[]
  purchaseRequests  PurchaseRequest[]
  purchaseOrders    PurchaseOrder[]
  budgets           Budget[]
  reportJobs        ReportJob[]
  notificationRules NotificationRule[]
  approvalRules     ApprovalRule[]

  @@map("companies")
}

model Role {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  company      Company  @relation(fields: [companyId], references: [id])
  name         String   @db.VarChar(100)
  description  String?
  isSystemRole Boolean  @default(false) @map("is_system_role")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]
  userRoles       UserRole[]
  approvalRules   ApprovalRule[]
  notifications   Notification[]

  @@unique([companyId, name])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  code        String  @unique @db.VarChar(100)
  module      String  @db.VarChar(50)
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

// Explicit join model (not implicit m-n) so a role's permission grant carries
// its own timestamp. `user_roles` follows the same pattern below, which is
// what allows a single user to hold more than one role at once.
model RolePermission {
  roleId       String     @map("role_id")
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id])
  grantedAt    DateTime   @default(now()) @map("granted_at")

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Department {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  company   Company  @relation(fields: [companyId], references: [id])
  name      String   @db.VarChar(150)
  code      String   @db.VarChar(30)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users             User[]
  costCenters       CostCenter[]
  expenses          Expense[]
  vehicles          Vehicle[]
  machines          Machine[]
  budgetAllocations BudgetAllocation[]
  consumableUsages  ConsumableUsage[]
  purchaseRequests  PurchaseRequest[]

  @@unique([companyId, code])
  @@map("departments")
}

model CostCenter {
  id           String      @id @default(uuid())
  companyId    String      @map("company_id")
  company      Company     @relation(fields: [companyId], references: [id])
  departmentId String?     @map("department_id")
  department   Department? @relation(fields: [departmentId], references: [id])
  name         String      @db.VarChar(150)
  code         String      @db.VarChar(30)
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  expenses          Expense[]
  budgetAllocations BudgetAllocation[]
  consumableUsages  ConsumableUsage[]

  @@unique([companyId, code])
  @@map("cost_centers")
}

model User {
  id                  String      @id @default(uuid())
  companyId           String      @map("company_id")
  company             Company     @relation(fields: [companyId], references: [id])
  departmentId        String?     @map("department_id")
  department          Department? @relation(fields: [departmentId], references: [id])
  name                String      @db.VarChar(150)
  email               String      @unique @db.VarChar(200)
  phone               String?     @db.VarChar(20)
  passwordHash        String      @map("password_hash")
  failedLoginAttempts Int         @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?   @map("locked_until")
  passwordResetToken  String?     @unique @map("password_reset_token")
  passwordResetExpiry DateTime?   @map("password_reset_expiry")
  isActive            Boolean     @default(true) @map("is_active")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  userRoles                 UserRole[]
  sessions                  Session[]
  expensesSubmitted         Expense[]                 @relation("ExpenseEmployee")
  expenseAttachments        ExpenseAttachment[]
  expenseApprovals          ExpenseApproval[]
  payments                  Payment[]
  notifications             Notification[]
  auditLogs                 AuditLog[]
  maintenanceRequests       MaintenanceRequest[]
  maintenanceRecords        MaintenanceRecord[]
  maintenanceSparesIssued   MaintenanceSpare[]        @relation("MaintenanceSpareIssuedBy")
  maintenanceSparesReceived MaintenanceSpare[]        @relation("MaintenanceSpareReceivedBy")
  stockMovementsPerformed   ConsumableStockMovement[]
  purchaseRequests          PurchaseRequest[]
  purchaseOrders            PurchaseOrder[]
  goodsReceipts             GoodsReceipt[]
  budgetsCreated            Budget[]
  reportJobs                ReportJob[]

  @@index([companyId])
  @@index([email])
  @@map("users")
}

model UserRole {
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id])
  roleId     String   @map("role_id")
  role       Role     @relation(fields: [roleId], references: [id])
  assignedAt DateTime @default(now()) @map("assigned_at")

  @@id([userId, roleId])
  @@map("user_roles")
}

model Session {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique @map("token_hash")
  ipAddress String?   @map("ip_address") @db.Inet
  userAgent String?   @map("user_agent")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ───────────────────────── Finance: expenses / vendors / payments ─────────────────────────

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  NEFT
  RTGS
  CHEQUE
  CREDIT

  @@map("payment_method")
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PAID
  CANCELLED

  @@map("expense_status")
}

enum ApprovalAction {
  SUBMITTED
  REVIEWED
  VERIFIED
  APPROVED
  REJECTED
  PAID
  CANCELLED

  @@map("approval_action")
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED

  @@map("payment_status")
}

// Confirmed max 2 levels in practice (category -> subcategory), so the old
// self-referencing tree is split into two flat tables instead of a
// parent-pointer tree (see OPEN_DECISIONS.md #3).
model ExpenseCategory {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  company   Company  @relation(fields: [companyId], references: [id])
  name      String   @db.VarChar(150)
  code      String   @db.VarChar(30)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subcategories     ExpenseSubcategory[]
  expenses          Expense[]
  approvalRules     ApprovalRule[]
  budgetAllocations BudgetAllocation[]

  @@unique([companyId, code])
  @@map("expense_categories")
}

model ExpenseSubcategory {
  id         String          @id @default(uuid())
  categoryId String          @map("category_id")
  category   ExpenseCategory @relation(fields: [categoryId], references: [id])
  name       String          @db.VarChar(150)
  code       String          @db.VarChar(30)
  isActive   Boolean         @default(true) @map("is_active")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  expenses Expense[]

  @@unique([categoryId, code])
  @@map("expense_subcategories")
}

model Vendor {
  id            String   @id @default(uuid())
  companyId     String   @map("company_id")
  company       Company  @relation(fields: [companyId], references: [id])
  name          String   @db.VarChar(200)
  contactPerson String?  @map("contact_person") @db.VarChar(150)
  phone         String?  @db.VarChar(20)
  email         String?  @db.VarChar(200)
  address       String?
  gstNumber     String?  @map("gst_number") @db.VarChar(20)
  pan           String?  @db.VarChar(15)
  category      String?  @db.VarChar(50)
  paymentTerms  String?  @map("payment_terms") @db.VarChar(100)
  bankDetails   Json?    @map("bank_details")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  expenses       Expense[]
  purchaseOrders PurchaseOrder[]
  payments       Payment[]

  @@index([companyId])
  @@map("vendors")
}

model Expense {
  id              String              @id @default(uuid())
  companyId       String              @map("company_id")
  company         Company             @relation(fields: [companyId], references: [id])
  expenseNumber   String              @unique @map("expense_number") @db.VarChar(30)
  expenseDate     DateTime            @map("expense_date") @db.Date
  categoryId      String              @map("category_id")
  category        ExpenseCategory     @relation(fields: [categoryId], references: [id])
  subcategoryId   String?             @map("subcategory_id")
  subcategory     ExpenseSubcategory? @relation(fields: [subcategoryId], references: [id])
  departmentId    String              @map("department_id")
  department      Department          @relation(fields: [departmentId], references: [id])
  costCenterId    String?             @map("cost_center_id")
  costCenter      CostCenter?         @relation(fields: [costCenterId], references: [id])
  vendorId        String?             @map("vendor_id")
  vendor          Vendor?             @relation(fields: [vendorId], references: [id])
  employeeId      String              @map("employee_id")
  employee        User                @relation("ExpenseEmployee", fields: [employeeId], references: [id])
  amount          Decimal             @db.Decimal(14, 2)
  taxAmount       Decimal             @default(0) @map("tax_amount") @db.Decimal(14, 2)
  discountAmount  Decimal             @default(0) @map("discount_amount") @db.Decimal(14, 2)
  totalAmount     Decimal             @map("total_amount") @db.Decimal(14, 2)
  paymentMethod   PaymentMethod?      @map("payment_method")
  status          ExpenseStatus       @default(DRAFT)
  description     String?
  referenceNumber String?             @map("reference_number") @db.VarChar(100)
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  attachments ExpenseAttachment[]
  approvals   ExpenseApproval[]
  payments    Payment[]

  @@index([companyId, expenseDate])
  @@index([departmentId, costCenterId, status])
  @@index([vendorId])
  @@map("expenses")
}

model ExpenseAttachment {
  id            String   @id @default(uuid())
  expenseId     String   @map("expense_id")
  expense       Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  fileName      String   @map("file_name") @db.VarChar(255)
  storageKey    String   @map("storage_key")
  fileType      String?  @map("file_type") @db.VarChar(50)
  fileSizeBytes BigInt?  @map("file_size_bytes")
  uploadedById  String   @map("uploaded_by")
  uploadedBy    User     @relation(fields: [uploadedById], references: [id])
  uploadedAt    DateTime @default(now()) @map("uploaded_at")

  @@index([expenseId])
  @@map("expense_attachments")
}

model ApprovalRule {
  id                  String           @id @default(uuid())
  companyId           String           @map("company_id")
  company             Company          @relation(fields: [companyId], references: [id])
  name                String           @db.VarChar(150)
  appliesToCategoryId String?          @map("applies_to_category_id")
  appliesToCategory   ExpenseCategory? @relation(fields: [appliesToCategoryId], references: [id])
  minAmount           Decimal          @default(0) @map("min_amount") @db.Decimal(14, 2)
  maxAmount           Decimal?         @map("max_amount") @db.Decimal(14, 2)
  approvalLevel       Int              @map("approval_level")
  approverRoleId      String           @map("approver_role_id")
  approverRole        Role             @relation(fields: [approverRoleId], references: [id])
  isActive            Boolean          @default(true) @map("is_active")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  @@map("approval_rules")
}

model ExpenseApproval {
  id            String         @id @default(uuid())
  expenseId     String         @map("expense_id")
  expense       Expense        @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  approvalLevel Int            @map("approval_level")
  action        ApprovalAction
  actedById     String         @map("acted_by")
  actedBy       User           @relation(fields: [actedById], references: [id])
  actedAt       DateTime       @default(now()) @map("acted_at")
  remarks       String?
  fromStatus    ExpenseStatus? @map("from_status")
  toStatus      ExpenseStatus? @map("to_status")

  @@index([expenseId, approvalLevel])
  @@map("expense_approvals")
}

// `payments` links directly to `expenses` and `vendors` only — there is no
// invoice step in between. See OPEN_DECISIONS.md #5: invoicing was dropped
// entirely rather than kept as a parallel, disconnected feature.
model Payment {
  id              String        @id @default(uuid())
  companyId       String        @map("company_id")
  company         Company       @relation(fields: [companyId], references: [id])
  paymentNumber   String        @unique @map("payment_number") @db.VarChar(30)
  expenseId       String?       @map("expense_id")
  expense         Expense?      @relation(fields: [expenseId], references: [id])
  vendorId        String        @map("vendor_id")
  vendor          Vendor        @relation(fields: [vendorId], references: [id])
  amount          Decimal       @db.Decimal(14, 2)
  paymentDate     DateTime      @map("payment_date") @db.Date
  method          PaymentMethod
  referenceNumber String?       @map("reference_number") @db.VarChar(100)
  status          PaymentStatus @default(PENDING)
  createdById     String        @map("created_by")
  createdBy       User          @relation(fields: [createdById], references: [id])
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([expenseId, paymentDate])
  @@map("payments")
}

// ───────────────────────── Notifications / audit ─────────────────────────

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL

  @@map("notification_severity")
}

model Notification {
  id         String               @id @default(uuid())
  companyId  String               @map("company_id")
  company    Company              @relation(fields: [companyId], references: [id])
  userId     String?              @map("user_id")
  user       User?                @relation(fields: [userId], references: [id])
  roleId     String?              @map("role_id")
  role       Role?                @relation(fields: [roleId], references: [id])
  type       String               @db.VarChar(50)
  severity   NotificationSeverity @default(INFO)
  title      String               @db.VarChar(200)
  message    String
  entityType String?              @map("entity_type") @db.VarChar(50)
  entityId   String?              @map("entity_id")
  isRead     Boolean              @default(false) @map("is_read")
  createdAt  DateTime             @default(now()) @map("created_at")

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid())
  companyId  String   @map("company_id")
  company    Company  @relation(fields: [companyId], references: [id])
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id])
  action     String   @db.VarChar(50)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String   @map("entity_id")
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  ipAddress  String?  @map("ip_address") @db.Inet
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId, createdAt])
  @@map("audit_logs")
}

// ───────────────────────── Operations: vehicles / fuel / transport ─────────────────────────

enum VehicleStatus {
  ACTIVE
  UNDER_MAINTENANCE
  INACTIVE
  SOLD

  @@map("vehicle_status")
}

enum VehicleDocumentType {
  INSURANCE
  FITNESS
  POLLUTION
  REGISTRATION
  OTHER

  @@map("vehicle_document_type")
}

enum FuelType {
  DIESEL
  PETROL
  CNG
  OTHER

  @@map("fuel_type")
}

model Vehicle {
  id                 String        @id @default(uuid())
  companyId          String        @map("company_id")
  company            Company       @relation(fields: [companyId], references: [id])
  departmentId       String?       @map("department_id")
  department         Department?   @relation(fields: [departmentId], references: [id])
  registrationNumber String        @unique @map("registration_number") @db.VarChar(30)
  vehicleType        String?       @map("vehicle_type") @db.VarChar(50)
  manufacturer       String?       @db.VarChar(100)
  model              String?       @db.VarChar(100)
  year               Int?          @db.SmallInt
  currentOdometer    Decimal       @default(0) @map("current_odometer") @db.Decimal(12, 2)
  status             VehicleStatus @default(ACTIVE)
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  documents        VehicleDocument[]
  fuelTransactions FuelTransaction[]
  trips            TransportTrip[]

  @@index([status])
  @@map("vehicles")
}

// Drivers are recorded per fuel_transaction and per transport_trip, not as a
// standing vehicle assignment — confirmed not needed (OPEN_DECISIONS.md #8).
model Driver {
  id            String    @id @default(uuid())
  companyId     String    @map("company_id")
  company       Company   @relation(fields: [companyId], references: [id])
  name          String    @db.VarChar(150)
  phone         String?   @db.VarChar(20)
  licenseNumber String?   @map("license_number") @db.VarChar(50)
  licenseExpiry DateTime? @map("license_expiry") @db.Date
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  fuelTransactions FuelTransaction[]
  trips            TransportTrip[]

  @@map("drivers")
}

// Replaces the old three scalar expiry fields on Vehicle (insurance/fitness/
// pollution) with one row per document type/expiry, so any number of
// document types can be tracked (OPEN_DECISIONS.md #8).
model VehicleDocument {
  id           String              @id @default(uuid())
  vehicleId    String              @map("vehicle_id")
  vehicle      Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  documentType VehicleDocumentType @map("document_type")
  storageKey   String              @map("storage_key")
  validFrom    DateTime?           @map("valid_from") @db.Date
  validUntil   DateTime?           @map("valid_until") @db.Date
  createdAt    DateTime            @default(now()) @map("created_at")

  @@index([vehicleId])
  @@index([validUntil])
  @@map("vehicle_documents")
}

model FuelTransaction {
  id                      String   @id @default(uuid())
  vehicleId               String   @map("vehicle_id")
  vehicle                 Vehicle  @relation(fields: [vehicleId], references: [id])
  driverId                String?  @map("driver_id")
  driver                  Driver?  @relation(fields: [driverId], references: [id])
  date                    DateTime @db.Date
  fuelType                FuelType @map("fuel_type")
  fuelStation             String?  @map("fuel_station") @db.VarChar(150)
  litres                  Decimal  @db.Decimal(10, 2)
  ratePerLitre            Decimal  @map("rate_per_litre") @db.Decimal(10, 2)
  totalAmount             Decimal  @map("total_amount") @db.Decimal(14, 2)
  odometerReading         Decimal  @map("odometer_reading") @db.Decimal(12, 2)
  previousOdometerReading Decimal  @map("previous_odometer_reading") @db.Decimal(12, 2)
  distanceTravelled       Decimal? @map("distance_travelled") @db.Decimal(12, 2)
  efficiencyKmpl          Decimal? @map("efficiency_kmpl") @db.Decimal(10, 3)
  isAnomaly               Boolean  @default(false) @map("is_anomaly")
  anomalyNote             String?  @map("anomaly_note")
  billStorageKey          String?  @map("bill_storage_key")
  createdAt               DateTime @default(now()) @map("created_at")

  @@index([vehicleId, date])
  @@index([vehicleId, odometerReading])
  @@map("fuel_transactions")
}

// Transporters are kept fully separate from vendors: a transporter moves
// goods (freight/trip economics), a vendor supplies goods/services billed
// via expenses/POs — different lifecycles and different fields, and the
// project owner confirmed this split is intentional, not an oversight
// (OPEN_DECISIONS.md #9). Do not fold this back into Vendor.
model Transporter {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  company   Company  @relation(fields: [companyId], references: [id])
  name      String   @db.VarChar(200)
  phone     String?  @db.VarChar(20)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  trips TransportTrip[]

  @@map("transporters")
}

model TransportTrip {
  id            String        @id @default(uuid())
  companyId     String        @map("company_id")
  company       Company       @relation(fields: [companyId], references: [id])
  tripNumber    String        @unique @map("trip_number") @db.VarChar(30)
  date          DateTime      @db.Date
  vehicleId     String        @map("vehicle_id")
  vehicle       Vehicle       @relation(fields: [vehicleId], references: [id])
  driverId      String?       @map("driver_id")
  driver        Driver?       @relation(fields: [driverId], references: [id])
  transporterId String?       @map("transporter_id")
  transporter   Transporter?  @relation(fields: [transporterId], references: [id])
  source        String        @db.VarChar(200)
  destination   String        @db.VarChar(200)
  material      String?       @db.VarChar(150)
  quantity      Decimal?      @db.Decimal(12, 3)
  unit          String?       @db.VarChar(20)
  freight       Decimal       @default(0) @db.Decimal(14, 2)
  loadingCost   Decimal       @default(0) @map("loading_cost") @db.Decimal(14, 2)
  unloadingCost Decimal       @default(0) @map("unloading_cost") @db.Decimal(14, 2)
  toll          Decimal       @default(0) @db.Decimal(14, 2)
  totalCost     Decimal       @map("total_cost") @db.Decimal(14, 2)
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  createdAt     DateTime      @default(now()) @map("created_at")

  @@index([date, vehicleId])
  @@map("transport_trips")
}

// ───────────────────────── Operations: machinery / maintenance ─────────────────────────

enum MachineStatus {
  RUNNING
  IDLE
  UNDER_MAINTENANCE
  BREAKDOWN
  RETIRED

  @@map("machine_status")
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("maintenance_priority")
}

enum MaintenanceRequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  CANCELLED

  @@map("maintenance_request_status")
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
  BREAKDOWN
  EMERGENCY
  SCHEDULED_SERVICE

  @@map("maintenance_type")
}

model Machine {
  id           String        @id @default(uuid())
  companyId    String        @map("company_id")
  company      Company       @relation(fields: [companyId], references: [id])
  departmentId String?       @map("department_id")
  department   Department?   @relation(fields: [departmentId], references: [id])
  machineCode  String        @unique @map("machine_code") @db.VarChar(30)
  name         String        @db.VarChar(150)
  manufacturer String?       @db.VarChar(100)
  model        String?       @db.VarChar(100)
  serialNumber String?       @map("serial_number") @db.VarChar(100)
  purchaseDate DateTime?     @map("purchase_date") @db.Date
  purchaseCost Decimal?      @map("purchase_cost") @db.Decimal(14, 2)
  location     String?       @db.VarChar(150)
  status       MachineStatus @default(RUNNING)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  documents            MachineDocument[]
  maintenanceRequests  MaintenanceRequest[]
  maintenanceRecords   MaintenanceRecord[]
  maintenanceSchedules MaintenanceSchedule[]
  consumableUsages     ConsumableUsage[]

  @@index([status])
  @@map("machines")
}

model MachineDocument {
  id           String   @id @default(uuid())
  machineId    String   @map("machine_id")
  machine      Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  documentType String?  @map("document_type") @db.VarChar(50)
  storageKey   String   @map("storage_key")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("machine_documents")
}

// Upstream stage that formally splits "someone reported a problem" from "the
// work that was actually done" (maintenance_records, below).
model MaintenanceRequest {
  id                 String                   @id @default(uuid())
  machineId          String                   @map("machine_id")
  machine            Machine                  @relation(fields: [machineId], references: [id])
  requestedById      String                   @map("requested_by")
  requestedBy        User                     @relation(fields: [requestedById], references: [id])
  problemDescription String                   @map("problem_description")
  priority           MaintenancePriority
  status             MaintenanceRequestStatus @default(OPEN)
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  maintenanceRecords MaintenanceRecord[]

  @@index([machineId, status])
  @@map("maintenance_requests")
}

model MaintenanceRecord {
  id                   String              @id @default(uuid())
  maintenanceRequestId String?             @map("maintenance_request_id")
  maintenanceRequest   MaintenanceRequest? @relation(fields: [maintenanceRequestId], references: [id])
  machineId            String              @map("machine_id")
  machine              Machine             @relation(fields: [machineId], references: [id])
  ticketNumber         String              @unique @map("ticket_number") @db.VarChar(30)
  maintenanceType      MaintenanceType     @map("maintenance_type")
  diagnosis            String?
  technician           String?             @db.VarChar(150)
  labourCost           Decimal             @default(0) @map("labour_cost") @db.Decimal(14, 2)
  consumablesCost      Decimal             @default(0) @map("consumables_cost") @db.Decimal(14, 2)
  otherCost            Decimal             @default(0) @map("other_cost") @db.Decimal(14, 2)
  totalCost            Decimal             @map("total_cost") @db.Decimal(14, 2)
  downtimeMinutes      Int?                @map("downtime_minutes")
  startTime            DateTime?           @map("start_time")
  endTime              DateTime?           @map("end_time")
  createdById          String              @map("created_by")
  createdBy            User                @relation(fields: [createdById], references: [id])
  createdAt            DateTime            @default(now()) @map("created_at")

  spares MaintenanceSpare[]

  @@index([machineId, startTime])
  @@map("maintenance_records")
}

model MaintenanceSchedule {
  id            String   @id @default(uuid())
  machineId     String   @map("machine_id")
  machine       Machine  @relation(fields: [machineId], references: [id])
  scheduleName  String?  @map("schedule_name") @db.VarChar(150)
  frequencyDays Int?     @map("frequency_days")
  nextDueDate   DateTime @map("next_due_date") @db.Date
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([nextDueDate, isActive])
  @@map("maintenance_schedules")
}

// Kept as-is: not part of the new 44-table design, but not silently dropped
// either — no decision was made to remove it (unlike SparePartMachine /
// ProductionOrder / ProductionExpense / PrintingExpense, which were
// explicitly confirmed unused and removed). FK renamed from sparePartId to
// consumableId to follow the SparePart -> Consumable rename.
model MaintenanceSpare {
  id                  String            @id @default(uuid())
  maintenanceRecordId String            @map("maintenance_record_id")
  maintenanceRecord   MaintenanceRecord @relation(fields: [maintenanceRecordId], references: [id], onDelete: Cascade)
  consumableId        String            @map("consumable_id")
  consumable          Consumable        @relation(fields: [consumableId], references: [id])
  quantity            Decimal           @db.Decimal(12, 3)
  unitCost            Decimal           @map("unit_cost") @db.Decimal(14, 2)
  totalCost           Decimal           @map("total_cost") @db.Decimal(14, 2)
  issuedById          String            @map("issued_by")
  issuedBy            User              @relation("MaintenanceSpareIssuedBy", fields: [issuedById], references: [id])
  receivedById        String?           @map("received_by")
  receivedBy          User?             @relation("MaintenanceSpareReceivedBy", fields: [receivedById], references: [id])
  issuedAt            DateTime          @default(now()) @map("issued_at")

  @@index([consumableId])
  @@index([maintenanceRecordId])
  @@map("maintenance_spares")
}

// ───────────────────────── Operations: consumables / inventory ─────────────────────────

enum InventoryTxnType {
  PURCHASE
  ISSUE
  RETURN
  ADJUSTMENT
  TRANSFER
  DAMAGED
  SCRAP

  @@map("inventory_txn_type")
}

// Renamed from the old `SparePart` model. No default-supplier FK — supplier
// is only ever recorded per purchase order now.
model Consumable {
  id              String   @id @default(uuid())
  companyId       String   @map("company_id")
  company         Company  @relation(fields: [companyId], references: [id])
  partNumber      String   @unique @map("part_number") @db.VarChar(50)
  name            String   @db.VarChar(150)
  category        String?  @db.VarChar(50)
  unit            String   @default("pcs") @db.VarChar(20)
  unitCost        Decimal  @default(0) @map("unit_cost") @db.Decimal(14, 2)
  currentStock    Decimal  @default(0) @map("current_stock") @db.Decimal(12, 3)
  minimumStock    Decimal  @default(0) @map("minimum_stock") @db.Decimal(12, 3)
  maximumStock    Decimal? @map("maximum_stock") @db.Decimal(12, 3)
  storageLocation String?  @map("storage_location") @db.VarChar(150)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  stockMovements       ConsumableStockMovement[]
  usages               ConsumableUsage[]
  purchaseRequestItems PurchaseRequestItem[]
  purchaseOrderItems   PurchaseOrderItem[]
  maintenanceSpares    MaintenanceSpare[]

  @@map("consumables")
}

// Renamed from `InventoryTransaction`. `quantity` is signed (+inbound /
// -outbound) per the new design's convention. Append-only: no `updatedAt`.
model ConsumableStockMovement {
  id            String           @id @default(uuid())
  consumableId  String           @map("consumable_id")
  consumable    Consumable       @relation(fields: [consumableId], references: [id])
  movementType  InventoryTxnType @map("movement_type")
  quantity      Decimal          @db.Decimal(12, 3)
  unitCost      Decimal?         @map("unit_cost") @db.Decimal(14, 2)
  totalCost     Decimal?         @map("total_cost") @db.Decimal(14, 2)
  referenceType String?          @map("reference_type") @db.VarChar(50)
  referenceId   String?          @map("reference_id")
  performedById String           @map("performed_by")
  performedBy   User             @relation(fields: [performedById], references: [id])
  movementDate  DateTime         @default(now()) @map("movement_date")
  notes         String?

  usages            ConsumableUsage[]
  goodsReceiptItems GoodsReceiptItem[]

  @@index([consumableId, movementDate])
  @@map("consumable_stock_movements")
}

model ConsumableUsage {
  id              String                  @id @default(uuid())
  consumableId    String                  @map("consumable_id")
  consumable      Consumable              @relation(fields: [consumableId], references: [id])
  machineId       String?                 @map("machine_id")
  machine         Machine?                @relation(fields: [machineId], references: [id])
  departmentId    String?                 @map("department_id")
  department      Department?             @relation(fields: [departmentId], references: [id])
  costCenterId    String?                 @map("cost_center_id")
  costCenter      CostCenter?             @relation(fields: [costCenterId], references: [id])
  quantity        Decimal                 @db.Decimal(12, 3)
  usageDate       DateTime                @map("usage_date") @db.Date
  stockMovementId String                  @map("stock_movement_id")
  stockMovement   ConsumableStockMovement @relation(fields: [stockMovementId], references: [id])

  @@index([consumableId, usageDate])
  @@map("consumable_usage")
}

// ───────────────────────── Procurement ─────────────────────────

enum PurchaseRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CONVERTED
  CANCELLED

  @@map("purchase_request_status")
}

enum PurchaseOrderStatus {
  REQUESTED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED

  @@map("purchase_order_status")
}

model PurchaseRequest {
  id            String                @id @default(uuid())
  companyId     String                @map("company_id")
  company       Company               @relation(fields: [companyId], references: [id])
  requestNumber String                @unique @map("request_number") @db.VarChar(30)
  requestedById String                @map("requested_by")
  requestedBy   User                  @relation(fields: [requestedById], references: [id])
  departmentId  String?               @map("department_id")
  department    Department?           @relation(fields: [departmentId], references: [id])
  status        PurchaseRequestStatus @default(DRAFT)
  createdAt     DateTime              @default(now()) @map("created_at")

  items          PurchaseRequestItem[]
  purchaseOrders PurchaseOrder[]

  @@map("purchase_requests")
}

model PurchaseRequestItem {
  id                 String          @id @default(uuid())
  purchaseRequestId  String          @map("purchase_request_id")
  purchaseRequest    PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  consumableId       String?         @map("consumable_id")
  consumable         Consumable?     @relation(fields: [consumableId], references: [id])
  description        String          @db.VarChar(255)
  quantity           Decimal         @db.Decimal(12, 3)
  estimatedUnitPrice Decimal?        @map("estimated_unit_price") @db.Decimal(14, 2)

  @@map("purchase_request_items")
}

model PurchaseOrder {
  id                String              @id @default(uuid())
  companyId         String              @map("company_id")
  company           Company             @relation(fields: [companyId], references: [id])
  poNumber          String              @unique @map("po_number") @db.VarChar(30)
  purchaseRequestId String?             @map("purchase_request_id")
  purchaseRequest   PurchaseRequest?    @relation(fields: [purchaseRequestId], references: [id])
  vendorId          String              @map("vendor_id")
  vendor            Vendor              @relation(fields: [vendorId], references: [id])
  status            PurchaseOrderStatus @default(REQUESTED)
  expectedDelivery  DateTime?           @map("expected_delivery") @db.Date
  totalAmount       Decimal             @map("total_amount") @db.Decimal(14, 2)
  createdById       String              @map("created_by")
  createdBy         User                @relation(fields: [createdById], references: [id])
  createdAt         DateTime            @default(now()) @map("created_at")

  items         PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]

  @@index([status])
  @@index([vendorId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String        @id @default(uuid())
  purchaseOrderId  String        @map("purchase_order_id")
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  consumableId     String?       @map("consumable_id")
  consumable       Consumable?   @relation(fields: [consumableId], references: [id])
  description      String        @db.VarChar(255)
  quantity         Decimal       @db.Decimal(12, 3)
  unitPrice        Decimal       @map("unit_price") @db.Decimal(14, 2)
  gstPercent       Decimal       @default(0) @map("gst_percent") @db.Decimal(5, 2)
  total            Decimal       @db.Decimal(14, 2)
  receivedQuantity Decimal       @default(0) @map("received_quantity") @db.Decimal(12, 3)

  goodsReceiptItems GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

model GoodsReceipt {
  id              String        @id @default(uuid())
  purchaseOrderId String        @map("purchase_order_id")
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  receiptNumber   String        @unique @map("receipt_number") @db.VarChar(30)
  receivedDate    DateTime      @map("received_date") @db.Date
  receivedById    String        @map("received_by")
  receivedBy      User          @relation(fields: [receivedById], references: [id])
  createdAt       DateTime      @default(now()) @map("created_at")

  items GoodsReceiptItem[]

  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id                  String                   @id @default(uuid())
  goodsReceiptId      String                   @map("goods_receipt_id")
  goodsReceipt        GoodsReceipt             @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItemId String                   @map("purchase_order_item_id")
  purchaseOrderItem   PurchaseOrderItem        @relation(fields: [purchaseOrderItemId], references: [id])
  quantityReceived    Decimal                  @map("quantity_received") @db.Decimal(12, 3)
  stockMovementId     String?                  @map("stock_movement_id")
  stockMovement       ConsumableStockMovement? @relation(fields: [stockMovementId], references: [id])

  @@map("goods_receipt_items")
}

// ───────────────────────── Management: budgets / reports / rules ─────────────────────────

enum BudgetPeriod {
  MONTHLY
  QUARTERLY
  YEARLY

  @@map("budget_period")
}

enum ReportJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED

  @@map("report_job_status")
}

// Split into a parent budget (overall total) and one-or-more child
// allocations (department/category/cost-center breakdown), per
// OPEN_DECISIONS.md #11. Each existing seeded budget converts to exactly one
// parent + one allocation.
model Budget {
  id          String       @id @default(uuid())
  companyId   String       @map("company_id")
  company     Company      @relation(fields: [companyId], references: [id])
  name        String       @db.VarChar(150)
  period      BudgetPeriod
  periodStart DateTime     @map("period_start") @db.Date
  periodEnd   DateTime     @map("period_end") @db.Date
  totalAmount Decimal      @map("total_amount") @db.Decimal(14, 2)
  createdById String       @map("created_by")
  createdBy   User         @relation(fields: [createdById], references: [id])
  createdAt   DateTime     @default(now()) @map("created_at")

  allocations BudgetAllocation[]

  @@map("budgets")
}

model BudgetAllocation {
  id              String           @id @default(uuid())
  budgetId        String           @map("budget_id")
  budget          Budget           @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  departmentId    String?          @map("department_id")
  department      Department?      @relation(fields: [departmentId], references: [id])
  categoryId      String?          @map("category_id")
  category        ExpenseCategory? @relation(fields: [categoryId], references: [id])
  costCenterId    String?          @map("cost_center_id")
  costCenter      CostCenter?      @relation(fields: [costCenterId], references: [id])
  allocatedAmount Decimal          @map("allocated_amount") @db.Decimal(14, 2)

  @@index([budgetId])
  @@index([departmentId, categoryId, costCenterId])
  @@map("budget_allocations")
}

model ReportJob {
  id               String          @id @default(uuid())
  companyId        String          @map("company_id")
  company          Company         @relation(fields: [companyId], references: [id])
  requestedById    String          @map("requested_by")
  requestedBy      User            @relation(fields: [requestedById], references: [id])
  reportType       String          @map("report_type") @db.VarChar(50)
  parameters       Json?
  status           ReportJobStatus @default(QUEUED)
  outputStorageKey String?         @map("output_storage_key")
  createdAt        DateTime        @default(now()) @map("created_at")
  completedAt      DateTime?       @map("completed_at")

  @@index([requestedById, status, createdAt])
  @@map("report_jobs")
}

model NotificationRule {
  id            String               @id @default(uuid())
  companyId     String               @map("company_id")
  company       Company              @relation(fields: [companyId], references: [id])
  key           String               @unique @db.VarChar(100)
  name          String               @db.VarChar(150)
  conditionJson Json                 @map("condition_json")
  severity      NotificationSeverity
  isActive      Boolean              @default(true) @map("is_active")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  @@map("notification_rules")
}

// Generic key/value config table — no design counterpart, kept as-is (not
// part of the 44-table count, not touched by this cutover).
model Settings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}
